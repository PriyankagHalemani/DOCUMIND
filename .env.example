# ==========================================
# DocuChat AI — Environment Configuration
# ==========================================

# Database
# Connects to MongoDB if available; seamlessly falls back to persistent local storage if offline
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=docuchat

# AI Provider Configuration: 'local' or 'openai'
# Set to 'local' for local retrieval + grounded extractive synthesis (no API keys required)
# Set to 'openai' to use OpenAI GPT-4o / GPT-4o-mini and OpenAI embeddings
AI_PROVIDER=local

# OpenAI Credentials (required only if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Database (Optional - Pinecone)
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_INDEX_NAME=

# Application Settings
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=30
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_CHUNKS=5
